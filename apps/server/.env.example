# Copy to apps/server/.env (never commit the real file).
NODE_ENV=production
PORT=3200
# Public https address of this server (the app's VITE_API_URL points here).
PUBLIC_URL=https://api.yourdomain.com
DB_PATH=data/boltsort.db
UPLOAD_DIR=data/uploads

# 32+ random characters, e.g. from: openssl rand -hex 32
OTP_SECRET=

# Admin panel login (https://api.yourdomain.com/admin)
ADMIN_EMAIL=you@example.com
# Make a hash with: npx -y bcryptjs-cli "your password"  (or set ADMIN_PASSWORD, 12+ characters)
ADMIN_PASSWORD_HASH=

# SMS for phone login: msg91 (India, needs a DLT-approved OTP template) or twilio
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Email for email login (any SMTP service)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Bolt Sort <no-reply@yourdomain.com>

# Origins allowed to call the API (defaults cover the Android and iOS app)
# CORS_ORIGINS=https://localhost,capacitor://localhost
