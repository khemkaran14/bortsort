# Address of the Bolt Sort server (apps/server). Leave empty to build an offline-only app
# (no login, no ads). Example: VITE_API_URL=https://api.yourdomain.com
VITE_API_URL=

# Sign in with Google (Google Cloud Console → APIs & Services → Credentials → OAuth client IDs).
# Web client id (also used by Android). Leave empty to hide the Google button.
VITE_GOOGLE_WEB_CLIENT_ID=
# iOS client id (only for iPhone builds)
VITE_GOOGLE_IOS_CLIENT_ID=
